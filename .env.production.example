# =============================================================================
# Vantrix — .env.production template
# =============================================================================
# Copy this file to `.env.production`, fill in the values, then validate with:
#   npm run verify:prod
# That script re-runs the exact zod schema from src/env.ts (production mode,
# no placeholder fallbacks) and flags common footguns before you deploy.
#
# Sections are ordered by priority for the coin-purchase fix currently in
# flight. Everything below "APP-WIDE REQUIRED" is required for the app to
# boot in production at all (src/env.ts throws on any missing required var),
# independent of the payment work.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. PAYMENTS — PAYSTACK + NOWPAYMENTS  (the actual fix — fill these in)
# -----------------------------------------------------------------------------

# Paystack Dashboard → Settings → API Keys & Webhooks → "Live Secret Key".
# Used for both API calls AND webhook signature verification — Paystack does
# not issue a separate webhook secret; PAYSTACK_SECRET_KEY covers both.
PAYSTACK_SECRET_KEY=

# NOWPayments Dashboard → Settings → API Keys → generate a key.
NOWPAYMENTS_API_KEY=

# NOWPayments Dashboard → Settings → IPN (Instant Payment Notification) →
# secret key. Used to verify incoming webhook signatures in
# src/app/api/payments/nowpayments/webhook/route.ts.
NOWPAYMENTS_IPN_SECRET=

# Optional — only needed if you also want Paystack-managed recurring
# subscriptions (auto-renewal) for the Premium tier, not the one-off coin
# packs. Leave blank to keep subscriptions on the existing manual-renewal
# fallback. Create each Plan in the Paystack Dashboard first, then paste its
# PLN_xxx code here.
PAYSTACK_PLAN_CODE_SPARK=
PAYSTACK_PLAN_CODE_SPARK_ANNUAL=
PAYSTACK_PLAN_CODE_SPARK_QUARTERLY=


# -----------------------------------------------------------------------------
# 2. PAYMENTS — STRIPE + PADDLE  (intentionally disabled — leave as-is)
# -----------------------------------------------------------------------------
# Stripe and Paddle are switched off account-wide right now
# (see src/lib/payments/provider-gate.ts's DISABLED_PROVIDERS). Their routes
# stay intact but 503 if hit directly. Leave these as placeholders —
# verify-production-config.mjs will print an info note, not fail the build.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
PADDLE_API_KEY=pdl_test_placeholder
PADDLE_WEBHOOK_SECRET=pdl_ntfset_placeholder

# NOTE: unlike the two keys above, PADDLE_ENVIRONMENT has NO placeholder
# fallback in real production mode (src/env.ts) — it must be explicitly set
# to 'sandbox' or 'production' or the app fails to boot entirely, even
# though Paddle checkout itself is gated off. Set to 'sandbox' unless/until
# Paddle is actually re-enabled.
PADDLE_ENVIRONMENT=sandbox

# Only needed if Paddle is re-enabled later (Catalog → Prices in the Paddle
# Dashboard). Leave blank for now.
PADDLE_PRICE_ID_PREMIUM_MONTHLY=
PADDLE_PRICE_ID_PREMIUM_QUARTERLY=
PADDLE_PRICE_ID_PREMIUM_ANNUAL=
PADDLE_PRICE_ID_TOKENS_100=
PADDLE_PRICE_ID_TOKENS_550=
PADDLE_PRICE_ID_TOKENS_1200=
PADDLE_PRICE_ID_TOKENS_2500=
PADDLE_PRICE_ID_TOKENS_7000=


# -----------------------------------------------------------------------------
# 3. APP-WIDE REQUIRED  (no placeholder fallback in prod — app won't boot
#    without these; fill in with your existing production values)
# -----------------------------------------------------------------------------

# Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Your production domain, e.g. https://vantrix.ink — used to build the
# Paystack/NOWPayments callback + webhook URLs, among other things.
NEXT_PUBLIC_APP_URL=

# OpenRouter — unified LLM gateway for chat/companion responses.
OPENROUTER_API_KEY=

# Upstash Redis (rate limiting, circuit breakers, caching).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security secrets — each must be 32+ random characters. Generate with:
#   openssl rand -hex 32
# Use a DIFFERENT value for each — verify-production-config.mjs flags
# key-material reuse across these.
ADMIN_SECRET_TOKEN=
WORKER_SECRET=
CRON_SECRET=
IP_HASH_SALT=


# -----------------------------------------------------------------------------
# 4. OPTIONAL — safe to leave blank; each feature fails open / no-ops
#    without its key rather than blocking the app
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_VERSION=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
GROK_API_KEY=
HOTAPI_API_URL=https://api.hotapi.ai
HOTAPI_API_KEY=
ATLAS_API_URL=https://api.atlas.ai
ATLAS_API_KEY=
CONTENT_ENGINE_DAILY_AI_CALLS=
CURATOR_DAILY_AI_CALLS=
BRAIN_SERVICE_URL=
BRAIN_SERVICE_API_KEY=
KAETAH_API_URL=
KAETAH_API_KEY=
KAETAH_ENABLED=false
OPENROUTER_FREE_FALLBACK_ENABLED=true
KAETAH_BRAIN_ENABLED=false

# Cron routes — only relevant if your Vercel plan differs from the default.
CRON_TIER=free

# Fal.ai — LoRA training / portrait generation.
FAL_KEY=

# Cloudflare R2 — permanent media storage (Fal-generated / admin-uploaded).
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ElevenLabs — premium voice (falls back to browser speech synthesis).
ELEVENLABS_API_KEY=

# Sentry — error tracking.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ERROR_LOG_SAMPLE_RATE=

ANOMALY_WEBHOOK_URL=
TRACING_ENDPOINT=

# Vercel Edge Config — injected automatically once a store is linked; leave blank.
EDGE_CONFIG=

# PostHog — product analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Protects /api/metrics with Bearer auth if set; endpoint self-disables (503)
# in production if left blank.
METRICS_SECRET=

# Resend — contact form email delivery. Without a key, submissions are
# logged server-side instead of emailed.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# Platform cost controls — safe defaults, raise once real usage justifies it.
PLATFORM_HOURLY_TOKEN_BUDGET=10000000
PLATFORM_BUDGET_REDUCTION_PCT=50
WORKER_BATCH_SIZE=5
PLATFORM_DAILY_VIDEO_BUDGET=500
PLATFORM_DAILY_3D_MODEL_BUDGET=100
GUEST_MESSAGE_LIMIT=7
WORKER_CONCURRENCY=1

# Web Push (VAPID) — generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@vantrix.ink
