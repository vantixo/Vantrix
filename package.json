{
  "name": "vantrix",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run cron:generate && npm run typecheck && next lint",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cron:generate": "node scripts/generate-vercel-json.mjs",
    "cron:generate:free": "cross-env CRON_TIER=free node scripts/generate-vercel-json.mjs",
    "cron:generate:pro": "cross-env CRON_TIER=pro node scripts/generate-vercel-json.mjs",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > src/types/supabase.ts",
    "db:migrate": "supabase db push",
    "worker": "tsx src/lib/queue/worker-runner.ts",
    "analyze": "cross-env ANALYZE=true next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run src/__tests__/sec-13-privileged-rpc-authorization.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "worker:dev": "tsx watch src/lib/queue/worker-runner.ts",
    "verify:prod": "tsx --env-file=.env.production scripts/verify-production-config.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "scenes:backfill-legendary": "tsx --env-file=.env.local scripts/backfill-legendary-scenes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@fal-ai/client": "^1.10.1",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@react-email/render": "^2.1.0",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@sentry/nextjs": "^10.56.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.50.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@upstash/ratelimit": "^1.2.0",
    "@upstash/redis": "^1.30.0",
    "@vercel/edge-config": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.462.0",
    "next": "^15.5.24",
    "posthog-js": "^1.194.3",
    "posthog-node": "^5.46.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "recharts": "^2.13.3",
    "resend": "^6.14.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "stripe": "^15.6.0",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0",
    "tsx": "^4.7.0",
    "typescript": "^5.8.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.169.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.19",
    "postcss": "8.5.24",
    "tailwindcss": "^3.4.14",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    },
    "react-reconciler": "^0.27.0"
  }
}
