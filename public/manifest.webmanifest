{
  "name": "Vantrix — AI Companions",
  "short_name": "Vantrix",
  "description": "Create, chat with, and grow relationships with AI companions on Vantrix.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A0A0A",
  "theme_color": "#0A0A0A",
  "icons": [
    { "src": "/icons/icon-128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "/icons/icon-384.png", "sizes": "384x384", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Chats",
      "url": "/chats",
      "icons": [{ "src": "/icons/shortcut-chat.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Discover",
      "url": "/",
      "icons": [{ "src": "/icons/shortcut-discover.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
