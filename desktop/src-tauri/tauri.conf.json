{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vantrix",
  "version": "1.0.0",
  "identifier": "app.vantrix.desktop",
  "build": {
    "frontendDist": "https://vantrix.app"
  },
  "app": {
    "windows": [
      {
        "title": "Vantrix",
        "url": "https://vantrix.app",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
